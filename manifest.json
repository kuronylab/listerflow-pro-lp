{
  "manifest_version": 3,
  "name": "ListerFlow Pro for Yaballe",
  "version": "1.1.0",
  "key": "",
  "description": "Yaballe Listerで、タイトル最適化とMIP出品フローを高速化する拡張機能。",
  "author": "KURONYLAB",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.yaballe.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/sw/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.yaballe.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}